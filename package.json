{
  "name": "dad-hq",
  "version": "1.0.0",
  "description": "Dad HQ — family planning & activity tracker, with auto-updating kid-friendly events",
  "private": true,
  "type": "module",
  "scripts": {
    "db:init": "wrangler d1 execute dad-hq --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute dad-hq --remote --file=./schema.sql",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
